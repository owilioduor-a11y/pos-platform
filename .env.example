# ==========================================
# POS SERVER CONFIGURATION
# ==========================================
APP_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
RUST_LOG=info,pos_server=debug,sqlx=warn

# PostgreSQL Database (Cloud Ledger)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pos_platform

# JWT Authentication (Generate a strong 64-char random hex string for production)
JWT_SECRET=replace_with_a_secure_random_64_char_secret_key_for_dev_only
JWT_EXPIRY_SECONDS=86400

# ==========================================
# KENYA PAYMENT RAILS (SANDBOX / PRODUCTION)
# ==========================================
# Safaricom Daraja API (M-Pesa Express STK Push)
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=your_daraja_sandbox_consumer_key
DARAJA_CONSUMER_SECRET=your_daraja_sandbox_consumer_secret
DARAJA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
DARAJA_SHORTCODE=174379
DARAJA_CALLBACK_URL=https://example.com

# Kenyan Card Acquirer / SoftPOS Backend API (e.g., KCB, Pesapal, DPO)
KENYA_ACQUIRER_PROVIDER=mock
KENYA_ACQUIRER_API_URL=https://example.com
KENYA_ACQUIRER_API_KEY=your_acquirer_sandbox_api_key
KENYA_ACQUIRER_WEBHOOK_SECRET=your_acquirer_webhook_signing_secret

# KRA eTIMS Tax Compliance Hook (Optional in Sandbox)
ETIMS_ENABLED=false
ETIMS_API_URL=https://kra.go.ke
ETIMS_TIN=P000000000X
ETIMS_BHF_ID=00

# ==========================================
# GLOBAL CARD PROCESSORS (PHASE 3)
# ==========================================
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
ADYEN_API_KEY=replace_me
ADYEN_MERCHANT_ACCOUNT=replace_me
