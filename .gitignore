# ==========================================
# SECRETS & ENVIRONMENT FILES
# ==========================================
.env
.env.*
!.env.example
*.pem
*.p12
*.jks
*.keystore
local.properties
google-services.json

# ==========================================
# RUST & CARGO
# ==========================================
/target/
**/*.rs.bk
*.pdb
Cargo.lock.bak

