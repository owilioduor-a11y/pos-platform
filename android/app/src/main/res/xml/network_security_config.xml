<?xml version="1.0" encoding="utf-8"?>
<!-- Production: TLS only, system trust store only. Cleartext is never permitted. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
